#include <iostream>
#include <vector>
 
const int M = 4, N = 4;
 
// counts paths from (i, j) to (M-1, N-1) whose total cost equals "cost"
int countPaths(const std::vector<std::vector<int>>& mat, int i, int j, int cost)
{
    // out of the matrix or cost already too much
    if (i >= M || j >= N || cost < 0)
        return 0;
 
    // last cell: path is valid only if the remaining cost equals this cell
    if (i == M - 1 && j == N - 1)
        return (cost == mat[i][j]) ? 1 : 0;
 
    int remaining = cost - mat[i][j];
    return countPaths(mat, i + 1, j, remaining) +   // move down
           countPaths(mat, i, j + 1, remaining);    // move right
}
 
void test(const std::vector<std::vector<int>>& mat, int cost)
{
    std::cout << "Cost " << cost << " -> number of paths: "
              << countPaths(mat, 0, 0, cost) << std::endl;
}
 
void show(const std::vector<std::vector<int>>& mat)
{
    for (const auto& row : mat)
    {
        for (int x : row) std::cout << x << " ";
        std::cout << std::endl;
    }
}
 
int main()
{
    std::vector<std::vector<int>> mat = {
        {4, 7, 1, 6},
        {6, 7, 3, 9},
        {3, 8, 1, 2},
        {7, 1, 7, 3}
    };
    
    show(mat);
    test(mat, 25);
    test(mat, 21);
    test(mat, 26);
    return 0;
}
